# ============================================================================
# DevFlow MCP Server - Environment Configuration
# ============================================================================
#
# Copy this file to .env and configure with your actual values:
#   cp .env.example .env
#   nano .env
#
# IMPORTANT: Never commit .env to git! It's in .gitignore for security.
#

# ----------------------------------------------------------------------------
# Review Backend (Choose Mode A or Mode B)
# ----------------------------------------------------------------------------
#
# Mode A: Claude Code Reviews (DEFAULT - Recommended for getting started)
#   - Uses your existing Claude Code access
#   - No additional costs
#   - No API key needed
#   - Leave ANTHROPIC_API_KEY commented out
#
# Mode B: Anthropic API Reviews (Optional - For high-volume usage)
#   - Uses Anthropic API directly
#   - Faster parallel reviews
#   - Costs API tokens (~$0.003 per review)
#   - Uncomment and set ANTHROPIC_API_KEY below
#
# Get your API key from: https://console.anthropic.com/settings/keys
#
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----------------------------------------------------------------------------
# GitHub Integration (Optional)
# ----------------------------------------------------------------------------
# Required for: github/create_pr, github/post_review tools
# Get your token from: https://github.com/settings/tokens
#
# Scopes needed:
#   - repo (full control of private repositories)
#   - workflow (update GitHub Action workflows)
#
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----------------------------------------------------------------------------
# Database Configuration (Optional - Advanced)
# ----------------------------------------------------------------------------
# Default: SQLite at ~/.devflow/devflow.db
#
# For SQLite (default - recommended):
# DEVFLOW_DATABASE_URL=sqlite+aiosqlite:///~/.devflow/devflow.db
#
# For PostgreSQL (advanced - requires setup):
# DEVFLOW_DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/devflow
#
# For NAS/Network storage:
# DEVFLOW_DATABASE_URL=sqlite+aiosqlite:///mnt/nas/.devflow/devflow.db
